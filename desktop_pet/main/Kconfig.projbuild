menu "Desktop Pet Xiaozhi Agent"

config DESKTOP_PET_AGENT_ENABLE
    bool "Enable Xiaozhi WebSocket agent (Z1-2 hello)"
    default y
    help
        Connect to a xiaozhi-compatible server: WS handshake + hello.
        Opus streaming comes in later slices.

config DESKTOP_PET_AGENT_WS_URI
    string "WebSocket URI"
    depends on DESKTOP_PET_AGENT_ENABLE
    default "ws://192.168.10.198:8000/xiaozhi/v1/"
    help
        Official: wss://api.tenclass.net/xiaozhi/v1/
        LAN: ws://<PC-LAN-IP>:8000/xiaozhi/v1/ (not Docker 172.x).
        Not the console MCP URL (wss://api.xiaozhi.me/mcp/?token=...).

config DESKTOP_PET_AGENT_ACCESS_TOKEN
    string "Bearer access token (empty if server auth disabled)"
    depends on DESKTOP_PET_AGENT_ENABLE
    default ""
    help
        Official cloud default is test-token. LAN server often leaves this empty.

config DESKTOP_PET_AGENT_OTA_URL
    string "Xiaozhi OTA register URL (empty = skip)"
    depends on DESKTOP_PET_AGENT_ENABLE
    default ""
    help
        Device registration only (activation code). Firmware download URLs are ignored.
        Official: https://api.tenclass.net/xiaozhi/ota/
        LAN Docker: leave empty.

config DESKTOP_PET_AGENT_HELLO_TIMEOUT_MS
    int "Hello reply timeout (ms)"
    depends on DESKTOP_PET_AGENT_ENABLE
    range 3000 30000
    default 10000

endmenu
