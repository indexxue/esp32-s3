# Phase 3 — hardware Secure Boot v2 (RSA-3072). eFuse burn on first boot (IRREVERSIBLE).
# Apply: scripts/secure_boot/apply_profile.ps1 -Profile secure_boot
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="../keys/dev/secure_boot_signing_key.pem"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK is not set
