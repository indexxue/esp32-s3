# Phase 3 — signed OTA without hardware Secure Boot (O12 dev; no eFuse burn).
# Apply: idf -Project camera signing-profile signed_ota --build
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="../keys/dev/secure_boot_signing_key.pem"
