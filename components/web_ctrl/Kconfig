menu "Web Control Library (web_ctrl)"

    config WEB_CTRL_AUTO_START
        bool "Auto-start SoftAP + HTTP server after board init"
        default n
        help
            When enabled, application calls web_ctrl_start() with defaults after BoardInit().
            Default SoftAP SSID is ESP32-WebCtrl; change credentials in menuconfig or in code.

    config WEB_CTRL_CMD_SYNC_TIMEOUT_MS
        int "POST /api/cmd: max wait for command execution (ms)"
        default 3000
        range 500 60000
        help
            HTTP handler blocks until the web_ctrl_cmd task finishes cmd_process_line_for_web or times out (504).

    config WEB_CTRL_STA_CONNECT_TIMEOUT_MS
        int "STA connect wait before SoftAP fallback (ms), strategy A"
        default 15000
        range 3000 120000
        help
            When NVS has sta_ssid, web_ctrl_start tries STA first and waits this long for DHCP before falling back to SoftAP.

    config WEB_CTRL_BMP_UPLOAD_MAX
        int "POST /api/upload/bmp: max multipart body size (bytes)"
        default 1048576
        range 65536 8388608
        help
            Entire multipart body limit (headers + file + boundaries). BMP payload is typically far smaller.

    config WEB_CTRL_BMP_CMD_TIMEOUT_MS
        int "After BMP upload: max wait for optional lcdbmp on LCD (ms)"
        default 25000
        range 3000 120000
        help
            Used only when upload URL query includes display=1 (or on/yes).

    config WEB_CTRL_VIDEO_UPLOAD_MAX
        int "POST /api/upload/video: max multipart body size (bytes)"
        default 16777216
        range 1048576 33554432
        help
            Entire multipart body limit for MJPEG AVI upload to /sdcard/videos/.

endmenu
